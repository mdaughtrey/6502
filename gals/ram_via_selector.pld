GAL16V8


NC A14 A13 A12 A11 A10 NC NC NC GND
A15 A9 A8 NC NC NC RAM0 RAM1 VIA VCC

; RAM1 = 0x8000–0xFFFF
/RAM1 = A15

; RAM0 = 0x0000–0x0200, 0x02ff-0x7FFF
/RAM0 = /A15 * A15
       + /A15 * A14
       + /A15 * A13
       + /A15 * A12
       + /A15 * A11
       + /A15 * A10
       + /A15 * /A9
       + /A15 * A8

; VIA = 0x0200–0x02FF
; A15..A10 = 000000, A9..A8 = 10
/VIA = /A15 * /A14 * /A13 * /A12 * /A11 * /A10 * A9 * /A8


