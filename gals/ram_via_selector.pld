GAL16V8


A4 A5 A6 A7 A8 A9 A10 A11 A12 GND
A13 A14 A15 VIA RAM0 RAM1 NC NC NC VCC

; RAM1 = 0x8000–0xFFFF
/RAM1 = A15

; RAM0 = 0x0000–0x7FFF
/RAM0 = /A15 * VIA

; VIA = 0x0200–0x02FF
; A15..A10 = 000000, A9..A8 = 10
/VIA = /A15 * /A14 * /A13 * /A12 * /A11 * /A10 *
      A9 * /A8 *
      /A7 * /A6 * /A5 * /A4


