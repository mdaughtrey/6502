.program break
.side_set 1 

.wrap_target
load_match:
    set pindirs, 1       side 1     ; make READY an output, start high
    pull block          side 1                ; wait for match data
    mov x, osr          side 1       ; x <- OSR
wait_for_match:
    mov y, pins         side 1      ; load pins without touching READY
    jmp x!=y, wait_for_match side 1  ; loop while no match

    ; --- match detected
    mov isr, y          side 1
    push noblock        side 1      ; send our address
    irq nowait 0        side 0      ; drive READY and raise IRQ, nowait

hold_until_ack:
    pull block          side 0      ; wait for the host to turn off the clock
    mov isr, osr        side 0
    nop                 side 1      ; then we wake and release READY
    push block          side 1      ; signal that we've released


hold_while_match:
    mov x, pins         side 1      ; now wait until the pins don't match so we
    jmp x!=y, load_match side 1   ; dont just trigger the IRQ again
    jmp hold_while_match side 1
.wrap
